{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nosignpdf",
  "compatibility_date": "2026-09-15",
  "pages_build_output_dir": "./dist",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/*",
      "!/sitemap.xml",
      "!/sitemap*.xml",
      "!/robots.txt",
      "!/ads.txt",
      "!/favicon.ico",
      "!/assets/*"
    ]
  }
}
